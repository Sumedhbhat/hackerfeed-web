language js(jsx);

or {
	JsxAttribute() as $styling where {
		$styling <: or { r"(?s)^className=.*", r"(?s)^class=.*", r"(?s)^style=.*" }
	},
	JsxSpreadAttribute() as $styling where {
		$styling <: or { r"(?s).*\bclassName\b.*", r"(?s).*\bstyle\b.*" }
	}
} where {
	register_diagnostic(
		span = $styling,
		message = "Only atoms and molecules style elements. Organisms, pages, routes and everything else describe *what* is on screen: use a component from @hackerfeed/ui/atoms or @hackerfeed/ui/molecules (add one, or a variant, if none fits). Do not work around this with spreads, `class`, global CSS or biome-ignore.",
		severity = "error"
	)
}
