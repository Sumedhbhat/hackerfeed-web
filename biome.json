{
	"$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
	"vcs": {
		"enabled": false,
		"clientKind": "git",
		"useIgnoreFile": false
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**/src/**/*",
			"**/.vscode/**/*",
			"**/index.html",
			"**/vite.config.ts",
			"!**/src/generated",
			"!**/src/routeTree.gen.ts",
			"!**/src/styles.css"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"complexity": {
				"useOptionalChain": "error"
			},
			"correctness": {
				"noRestrictedElements": {
					"level": "error",
					"options": {
						"elements": {
							"button": "Use <Button> from #/components/atoms/Button instead of a raw <button>."
						}
					}
				}
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"plugins": ["./lint/no-button-look-classes.grit"],
	"overrides": [
		{
			"includes": [
				"**/src/components/atoms/**",
				"**/src/components/molecules/**",
				"**/*.test.tsx"
			],
			"linter": {
				"rules": {
					"correctness": {
						"noRestrictedElements": "off"
					}
				}
			}
		},
		{
			"includes": [
				"**/src/components/organisms/**",
				"**/src/components/pages/**",
				"**/src/routes/**",
				"!**/*.test.tsx"
			],
			"plugins": ["./lint/no-styling-outside-atoms.grit"]
		},
		{
			"includes": [
				"**/src/components/atoms/**",
				"**/src/components/molecules/**",
				"!**/*.test.tsx"
			],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"#/hooks/*",
											"#/lib/*",
											"#/server/*",
											"#/components/organisms/*",
											"#/components/pages/*"
										],
										"message": "Atoms and molecules are presentational: take data and callbacks as props instead of importing hooks, lib or higher layers."
									}
								]
							}
						}
					}
				}
			}
		}
	]
}
