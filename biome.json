{
	"$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
	"vcs": {
		"enabled": false,
		"clientKind": "git",
		"useIgnoreFile": false
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**/src/**/*",
			"**/.vscode/**/*",
			"**/index.html",
			"**/vite.config.ts",
			"!**/src/generated",
			"!**/src/routeTree.gen.ts",
			"!**/src/styles.css"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"complexity": {
				"useOptionalChain": "error"
			},
			"correctness": {
				"noRestrictedElements": {
					"level": "error",
					"options": {
						"elements": {
							"button": "Use <Button> from #/components/ui/atoms/Button instead of a raw <button>."
						}
					}
				}
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"plugins": ["./lint/no-button-look-classes.grit"],
	"overrides": [
		{
			"includes": ["**/src/components/atoms/**", "**/src/components/molecules/**", "**/*.test.tsx"],
			"linter": {
				"rules": {
					"correctness": {
						"noRestrictedElements": "off"
					}
				}
			}
		}
	]
}
