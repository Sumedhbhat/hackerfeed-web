{
	"$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
	"vcs": {
		"enabled": false,
		"clientKind": "git",
		"useIgnoreFile": false
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**/src/**/*",
			"**/.vscode/**/*",
			"**/index.html",
			"**/vite.config.ts",
			"!**/src/generated",
			"!**/src/routeTree.gen.ts",
			"!**/src/styles.css"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"complexity": {
				"useOptionalChain": "error"
			},
			"a11y": {
				"noLabelWithoutControl": {
					"level": "error",
					"options": {
						"inputComponents": ["TextInput", "TextArea"]
					}
				}
			},
			"correctness": {
				"noRestrictedElements": {
					"level": "error",
					"options": {
						"elements": {
							"button": "Use <Button> from @hackerfeed/ui/atoms/Button.",
							"a": "Use <TextLink>/<ExternalLink> from @hackerfeed/ui/atoms/Link or <ButtonLink>/<ExternalButtonLink> from @hackerfeed/ui/atoms/Button.",
							"input": "Use <TextInput> from @hackerfeed/ui/atoms/TextField, or add a field atom.",
							"textarea": "Use <TextArea> from @hackerfeed/ui/atoms/TextField.",
							"select": "Use <Select> from @hackerfeed/ui/atoms/TextField or <SelectField> from @hackerfeed/ui/molecules/SelectField.",
							"h1": "Use <Heading level={1}> from @hackerfeed/ui/atoms/Heading.",
							"h2": "Use <Heading level={2}> from @hackerfeed/ui/atoms/Heading.",
							"h3": "Use <Heading level={3}> from @hackerfeed/ui/atoms/Heading.",
							"h4": "Use <Heading level={4}> from @hackerfeed/ui/atoms/Heading.",
							"h5": "Use <Heading> from @hackerfeed/ui/atoms/Heading.",
							"h6": "Use <Heading> from @hackerfeed/ui/atoms/Heading.",
							"p": "Use <Text> from @hackerfeed/ui/atoms/Text.",
							"img": "Use <Avatar> or add an image atom in @hackerfeed/ui/atoms.",
							"style": "Styles live in atoms/molecules (Tailwind) or src/styles.css, never in an inline <style>."
						}
					}
				}
			},
			"style": {
				"noRestrictedImports": {
					"level": "error",
					"options": {
						"patterns": [
							{
								"group": ["@base-ui/**"],
								"message": "Base UI is wrapped by the atoms in @hackerfeed/ui/atoms (Tabs, Menu, Toggle, Select...). Use or extend an atom instead of importing Base UI here."
							}
						]
					}
				}
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"overrides": [
		{
			"includes": [
				"**/packages/ui/src/atoms/**",
				"**/packages/ui/src/molecules/**",
				"**/*.test.tsx",
				"**/src/client-entry.tsx",
				"**/src/router.tsx",
				"**/src/server/errors/**"
			],
			"linter": {
				"rules": {
					"correctness": {
						"noRestrictedElements": "off"
					}
				}
			}
		},
		{
			"includes": [
				"**/src/**/*.tsx",
				"!**/packages/ui/src/atoms/**",
				"!**/packages/ui/src/molecules/**",
				"!**/*.test.tsx",
				"!**/src/client-entry.tsx",
				"!**/src/router.tsx",
				"!**/src/server/errors/**"
			],
			"plugins": ["./lint/no-styling-outside-atoms.grit"]
		},
		{
			"includes": ["**/packages/ui/src/atoms/**", "!**/*.test.tsx"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["#/**", "@hackerfeed/**", "!@hackerfeed/ui/**"],
										"message": "Atoms and molecules are presentational: take data and callbacks as props instead of importing app code or other workspace packages."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["**/packages/ui/src/molecules/**", "!**/*.test.tsx"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["#/**", "@hackerfeed/**", "!@hackerfeed/ui/**"],
										"message": "Atoms and molecules are presentational: take data and callbacks as props instead of importing app code or other workspace packages."
									},
									{
										"group": ["@base-ui/**"],
										"message": "Base UI is wrapped by the atoms in @hackerfeed/ui/atoms (Tabs, Menu, Toggle, Select...). Use or extend an atom instead of importing Base UI here."
									}
								]
							}
						}
					}
				}
			}
		}
	]
}
