{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "hackerfeed-web",
	"compatibility_date": "2025-09-02",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"main": "src/server.ts",
	"triggers": {
		"crons": ["30 23 * * *"]
	},
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1,
		"traces": {
			"enabled": true,
			"head_sampling_rate": 1
		}
	},
	"vars": {
		"SERVER_URL": "",
		"VITE_APP_TITLE": "Hacker Feed",
		"VITE_SENTRY_ENVIRONMENT": "production",
		"VITE_SENTRY_TRACES_SAMPLE_RATE": "1",
		"SENTRY_ENVIRONMENT": "production",
		"SENTRY_TRACES_SAMPLE_RATE": "1",
		"VITE_WORKOS_API_HOSTNAME": "api.workos.com",
		"VITE_WORKOS_REDIRECT_URI": "https://hackerfeed-web.kgqk4vdcfq.workers.dev/auth/callback"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "hackerfeed",
			"database_id": "local-hackerfeed",
			"migrations_dir": "migrations"
		}
	]
}
