{
	"$schema": "./node_modules/nx/schemas/nx-schema.json",
	"defaultBase": "master",
	"targetDefaults": {
		"lint": {
			"command": "biome check {projectRoot}",
			"cache": false
		},
		"typecheck": {
			"command": "tsc --noEmit -p {projectRoot}",
			"cache": false
		},
		"test": {
			"command": "vitest run",
			"options": { "cwd": "{projectRoot}" },
			"cache": false
		},
		"build": { "cache": false }
	}
}
