{
	"$schema": "./node_modules/nx/schemas/nx-schema.json",
	"defaultBase": "master",
	"namedInputs": {
		"workspacePolicy": [
			"{workspaceRoot}/package.json",
			"{workspaceRoot}/bun.lock",
			"{workspaceRoot}/bunfig.toml",
			"{workspaceRoot}/nx.json",
			"{workspaceRoot}/tsconfig.base.json",
			"{workspaceRoot}/biome.json",
			"{workspaceRoot}/lint/**/*",
			"{workspaceRoot}/tools/workspace/**/*",
			"{workspaceRoot}/.github/workflows/**/*"
		],
		"default": [
			"{projectRoot}/**/*",
			"workspacePolicy"
		]
	},
	"targetDefaults": {
		"lint": {
			"command": "biome check {projectRoot}",
			"inputs": [
				"default"
			],
			"cache": true
		},
		"typecheck": {
			"command": "tsc --noEmit -p {projectRoot}",
			"inputs": [
				"default",
				"^default",
				{
					"runtime": "node --version"
				}
			],
			"cache": true
		},
		"test": {
			"command": "vitest run",
			"options": {
				"cwd": "{projectRoot}"
			},
			"inputs": [
				"default",
				"^default",
				{
					"runtime": "node --version"
				},
				{
					"env": "VITE_DEMO_DATA"
				}
			],
			"cache": true
		},
		"build": {
			"inputs": [
				"default",
				"^default"
			],
			"cache": false
		},
		"fmt": {
			"inputs": [
				"default",
				"^default"
			],
			"cache": false
		},
		"validate": {
			"inputs": [
				"default",
				"^default"
			],
			"cache": false
		},
		"plan": {
			"cache": false
		},
		"apply": {
			"cache": false
		},
		"deploy": {
			"cache": false
		}
	}
}
