{
	"$schema": "./node_modules/nx/schemas/nx-schema.json",
	"defaultBase": "master",
	"targetDefaults": {
		"typecheck": {
			"command": "tsc --noEmit -p {projectRoot}",
			"cache": false
		},
		"test": {
			"command": "vitest run",
			"options": {
				"cwd": "{projectRoot}"
			},
			"cache": false
		},
		"build": {
			"cache": false
		}
	}
}
