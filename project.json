{
	"$schema": "./node_modules/nx/schemas/project-schema.json",
	"name": "hackerfeed-web",
	"targets": {
		"lint": { "command": "biome check" },
		"typecheck": { "command": "tsc --noEmit" },
		"test": { "command": "vitest run" },
		"build": { "command": "vite build" },
		"test-infra": {
			"command": "python3 -m unittest discover -s infra/tests -p 'test_*.py' && bun test infra/tests/state-backend.test.js"
		}
	}
}
