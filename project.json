{
	"$schema": "./node_modules/nx/schemas/project-schema.json",
	"name": "web",
	"projectType": "application",
	"sourceRoot": "src",
	"tags": [
		"type:app",
		"platform:browser",
		"platform:server",
		"scope:hackerfeed"
	],
	"metadata": {
		"owner": "@Sumedhbhat"
	},
	"targets": {
		"lint": {
			"command": "biome check ."
		},
		"typecheck": {
			"command": "tsc --noEmit"
		},
		"test": {
			"command": "vitest run"
		},
		"build": {
			"command": "vite build",
			"options": {
				"cwd": "{projectRoot}"
			}
		},
		"build-demo": {
			"command": "vite build",
			"options": {
				"cwd": "{projectRoot}",
				"env": {
					"VITE_DEMO_DATA": "true"
				}
			}
		}
	}
}
