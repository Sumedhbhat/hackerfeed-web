generator client {
  provider = "prisma-client"
  runtime  = "cloudflare"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model AppUser {
  id           String     @id @default(cuid())
  workosUserId String     @unique
  favorites    Favorite[]

  @@map("app_users")
}

model Story {
  id             String     @id @default(cuid())
  hnStoryId      Int        @unique
  title          String?
  url            String?
  text           String?
  score          Int        @default(0)
  hnPostedAt     DateTime?  @db.Timestamp(6)
  authorUsername String?
  commentCount   Int        @default(0)
  commentIds     Int[]      @default([])
  favorites      Favorite[]

  @@map("stories")
}

model Favorite {
  id          String   @id @default(cuid())
  appUserId   String
  storyId     String
  appUser     AppUser  @relation(fields: [appUserId], references: [id], onDelete: Cascade)
  story       Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now()) @db.Timestamp(6)

  @@unique([appUserId, storyId])
  @@map("favorites")
}
