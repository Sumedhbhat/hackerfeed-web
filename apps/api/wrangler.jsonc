{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "hackerfeed-api",
	"main": "src/index.ts",
	"compatibility_date": "2025-09-02",
	"compatibility_flags": ["nodejs_compat"],
	"triggers": {
		"crons": ["30 23 * * *"]
	},
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1,
		"traces": {
			"enabled": true,
			"head_sampling_rate": 1
		}
	},
	"vars": {
		"ALLOWED_ORIGIN": "https://hackerfeed-web.kgqk4vdcfq.workers.dev",
		"WORKOS_API_HOSTNAME": "api.workos.com",
		"SENTRY_ENVIRONMENT": "production",
		"SENTRY_TRACES_SAMPLE_RATE": "0.1"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "hackerfeed",
			"database_id": "local-hackerfeed",
			"migrations_dir": "../../packages/backend/migrations"
		}
	]
}
