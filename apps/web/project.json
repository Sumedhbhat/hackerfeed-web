{
	"$schema": "../../node_modules/nx/schemas/project-schema.json",
	"name": "web",
	"projectType": "application",
	"sourceRoot": "apps/web/src",
	"tags": ["type:app", "platform:browser", "platform:server", "scope:hackerfeed"],
	"metadata": { "owner": "@Sumedhbhat" },
	"targets": {
		"lint": {},
		"typecheck": {},
		"test": {},
		"build": {
			"command": "vite build",
			"options": { "cwd": "{projectRoot}" }
		},
		"build-demo": {
			"command": "vite build",
			"options": { "cwd": "{projectRoot}", "env": { "VITE_DEMO_DATA": "true" } }
		}
	}
}
