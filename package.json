{
  "name": "hackerfeed-web",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "security:audit": "bun audit --audit-level=high",
    "test": "vitest run",
    "deploy": "bun run build && wrangler deploy",
    "cf:typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "solve:issues": "node scripts/solve-issues.mjs",
    "format": "biome format",
    "lint": "biome lint",
    "check": "biome check"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "^1.50.0",
    "@sentry/cloudflare": "^10.56.0",
    "@sentry/react": "^10.56.0",
    "@t3-oss/env-core": "^0.13.10",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-query": "latest",
    "@tanstack/react-query-devtools": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-router-ssr-query": "latest",
    "@tanstack/react-start": "latest",
    "@tanstack/react-store": "latest",
    "@tanstack/router-plugin": "^1.132.0",
    "@tanstack/store": "latest",
    "@trpc/client": "^11.11.0",
    "@trpc/server": "^11.11.0",
    "@trpc/tanstack-react-query": "^11.11.0",
    "@workos-inc/authkit-react": "^0.16.0",
    "@workos-inc/node": "^10.0.0",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.3",
    "ky": "^2.0.2",
    "lucide-react": "^1.28.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "superjson": "^2.2.2",
    "tailwindcss": "^4.1.18",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/devtools-event-client": "latest",
    "@tanstack/devtools-vite": "^0.8.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "drizzle-kit": "^0.31.10",
    "happy-dom": "^20.10.6",
    "jsdom": "^30.0.1",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^3.2.6",
    "wrangler": "^4.118.0"
  },
  "overrides": {
    "js-yaml": "4.3.0",
    "postcss": "8.5.25",
    "seroval": "1.6.0",
    "seroval-plugins": "1.6.0",
    "shell-quote": "1.10.0",
    "undici": "7.28.0",
    "vite": "7.3.5",
    "ws": "8.21.0"
  },
