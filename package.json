{
  "name": "hackerfeed",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/web dev",
    "dev:demo": "bun run --cwd apps/web dev:demo",
    "build": "nx run web:build",
    "build:demo": "nx run web:build-demo",
    "preview": "bun run --cwd apps/web preview",
    "preview:private": "bun run --cwd apps/web preview:private",
    "demo-data:compare": "bun run --cwd apps/web demo-data:compare",
    "cf:typegen": "bun run --cwd apps/web cf:typegen",
    "db:generate": "bun run --cwd packages/backend db:generate",
    "db:migrate:local": "bun run --cwd apps/web db:migrate:local",
    "security:audit": "bun audit --audit-level=high",
    "test": "nx run-many -t test",
    "typecheck": "nx run-many -t typecheck",
    "check:workspace": "bun tools/workspace/src/check-workspace.ts",
    "new:library": "bun tools/workspace/src/new-library.ts",
    "format": "biome format",
    "lint": "biome lint",
    "check": "biome check"
  },
  "dependencies": {
    "jose": "^6.2.12"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^26.6.3",
    "nx": "23.3.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4",
    "wrangler": "^4.151.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  },
  "overrides": {
    "esbuild": "^0.28.2",
    "postcss-selector-parser": "^7.1.6",
    "undici": "^7.30.1"
  }
}
