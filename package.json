{
  "name": "hackerfeed",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter @hackerfeed/web dev",
    "dev:demo": "bun run --filter @hackerfeed/web dev:demo",
    "build": "nx run web:build",
    "build:demo": "nx run web:build-demo",
    "security:audit": "bun audit --audit-level=high",
    "test": "nx run-many -t test",
    "typecheck": "nx run-many -t typecheck",
    "format": "biome format",
    "lint": "biome lint",
    "check": "biome check",
    "new:library": "bun tools/workspace/src/new-library.ts",
    "check:workspace": "bun tools/workspace/src/check-workspace.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^26.6.3",
    "nx": "23.3.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  },
  "overrides": {
    "esbuild": "^0.28.2",
    "postcss-selector-parser": "^7.1.6",
    "undici": "^7.30.1"
  }
}
