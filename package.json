{
  "name": "hackerfeed",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "sh scripts/install-git-hooks.sh",
    "dev": "bun run --filter '@hackerfeed/web' --filter '@hackerfeed/api' dev",
    "dev:demo": "bun run --cwd apps/web dev:demo",
    "build": "nx run-many -t build -p web,api",
    "build:demo": "nx run web:build-demo",
    "preview": "bun run --cwd apps/web preview",
    "preview:private": "bun run --cwd apps/web preview:private",
    "demo-data:compare": "bun run --cwd apps/web demo-data:compare",
    "cf:typegen": "bun run --filter '@hackerfeed/web' --filter '@hackerfeed/api' cf:typegen",
    "db:generate": "bun run --cwd packages/backend db:generate",
    "db:migrate:local": "bun run --cwd apps/api db:migrate:local",
    "security:audit": "bun audit --audit-level=high",
    "test": "nx run-many -t test",
    "e2e": "nx run web-e2e:e2e",
    "typecheck": "nx run-many -t typecheck",
    "format": "biome format",
    "lint:ui": "node apps/web/scripts/lint-ui.ts",
    "lint": "bun run lint:ui && biome lint",
    "check": "bun run lint:ui && biome check",
    "check:push": "bash scripts/check-dependency-overrides.sh && bash scripts/check-build.sh",
    "dev:api": "bun run --cwd apps/api dev"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/node": "^26.6.3",
    "nx": "23.3.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4",
    "wrangler": "^4.151.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  },
  "overrides": {
    "esbuild": "^0.28.2",
    "postcss-selector-parser": "^7.1.6",
    "undici": "^7.30.1"
  }
}
