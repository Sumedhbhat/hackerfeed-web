{
	"$schema": "../../node_modules/nx/schemas/project-schema.json",
	"name": "infra-prod",
	"projectType": "application",
	"sourceRoot": "infra/cloudflare-prod",
	"tags": [
		"type:infra",
		"platform:ci",
		"scope:hackerfeed"
	],
	"metadata": {
		"owner": "@Sumedhbhat",
		"stateName": "prod"
	},
	"implicitDependencies": [
		"infra-ci",
		"tf-ci-token"
	],
	"targets": {
		"fmt": {
			"command": "terraform fmt -check -diff",
			"options": {
				"cwd": "infra/cloudflare-prod"
			}
		},
		"validate": {
			"command": "terraform init -backend=false -input=false -lockfile=readonly && terraform validate",
			"options": {
				"cwd": "infra/cloudflare-prod"
			}
		},
		"plan": {
			"command": "tools/infra-ci/terraform.sh prod plan -input=false",
			"cache": false
		},
		"apply": {
			"command": "tools/infra-ci/terraform.sh prod apply -input=false",
			"cache": false
		}
	}
}
